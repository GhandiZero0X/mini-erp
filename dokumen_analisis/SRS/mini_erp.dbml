// ============================================================
// ERD Mini ERP - PT Nusantara Distribusi
// Inventory & Sales Management System
// Database: PostgreSQL | Dibuat untuk dbdiagram.io
// Acuan: SRS v1.0 (BR-01..BR-11, NFR-07..NFR-09, NFR-13, NFR-17, NFR-19)
// ============================================================

Project mini_erp {
  database_type: 'PostgreSQL'
  Note: '''
    Mini ERP - Inventory & Sales.
    - Dokumen transaksi tidak pernah dihapus, hanya berstatus Dibatalkan (BR-09).
    - Semua FK memakai ON DELETE RESTRICT.
    - Stok hanya berubah lewat StockService yang selalu menulis stock_movements
      dalam database transaction yang sama (BR-06, BR-08).
    - Sisa kuantitas PO/SO tidak disimpan, dihitung dari item GR/Delivery berstatus Aktif.
  '''
}

// ============================================================
// MASTER DATA & AUTENTIKASI
// ============================================================

Table roles {
  id integer [pk, increment]
  code varchar(30) [not null, unique, note: 'admin, purchasing, gudang, sales, manajer']
  name varchar(50) [not null, note: 'Nama tampilan peran']

  Note: 'Lima peran tetap sesuai BRD. Tabel dipakai agar peran baru cukup lewat data (NFR-19).'
}

Table users {
  id integer [pk, increment]
  full_name varchar(100) [not null, note: 'VR-33']
  username varchar(50) [not null, unique, note: 'VR-34, tidak dapat diubah setelah dibuat']
  password_hash varchar(255) [not null, note: 'Hash password, bukan teks asli (NFR-01)']
  role_id integer [not null, note: 'Satu akun satu peran']
  is_active boolean [not null, default: true, note: 'Akun tidak dihapus, hanya dinonaktifkan']
  failed_login_count smallint [not null, default: 0, note: 'Reset saat login berhasil atau akun dibuka kuncinya']
  locked_until timestamptz [note: 'Terkunci bila NOT NULL dan > now() (NFR-17, 15 menit)']
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    role_id
    is_active
  }

  checks {
    `failed_login_count >= 0` [name: 'chk_users_failed_login']
  }
}

Table categories {
  id integer [pk, increment]
  name varchar(100) [not null, unique, note: 'VR-19, VR-20']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table units {
  id integer [pk, increment]
  code varchar(20) [not null, unique, note: 'Kode satuan, mis. PCS, KG, BOX']
  name varchar(50) [not null, note: 'Nama satuan']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    name
  }
}

Table products {
  id integer [pk, increment]
  code varchar(30) [not null, unique, note: 'BR-11, VR-03; terkunci bila sudah dipakai transaksi (VR-21)']
  name varchar(150) [not null]
  unit_id integer [not null, note: 'FK ke master units']
  purchase_price numeric(15,2) [not null, default: 0, note: 'Default harga satuan di PO']
  selling_price numeric(15,2) [not null, default: 0, note: 'Default harga satuan di SO']
  category_id integer [not null]

  // ─── Batas stok untuk reorder alert & blocking PO ─────────
  min_stock integer [not null, default: 0, note: 'Batas bawah; stok <= min → produk muncul di dashboard purchasing sebagai "perlu PO"']
  max_stock integer [note: 'Batas atas; NULL = tanpa batas. Stok + pending_po + qty_baru tidak boleh melebihi']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    `lower(code)` [unique, name: 'uq_products_code_lower', note: 'Unik tanpa membedakan huruf besar/kecil']
    category_id
    unit_id
    name
    max_stock [name: 'idx_products_max_stock', note: 'Mempercepat query dashboard "mendekati batas atas"']
  }

  checks {
    `purchase_price >= 0` [name: 'chk_products_purchase_price']
    `selling_price >= 0` [name: 'chk_products_selling_price']
    `min_stock >= 0` [name: 'chk_products_min_stock']
    `max_stock IS NULL OR max_stock >= min_stock` [name: 'chk_products_max_stock']
  }

  Note: '''
    Tidak ada kolom stok (quantity) di sini. Saldo stok ada di stock_balances.
    min_stock & max_stock adalah parameter untuk:
    - Dashboard widget "Stok di Bawah Minimum" (ketika quantity <= min_stock)
    - Dashboard widget "Stok Mendekati Batas Atas" (ketika quantity >= 0.8 * max_stock)
    - Validasi PO: total (quantity + pending_po + qty_baru) tidak boleh > max_stock
    max_stock = NULL berarti produk tidak memiliki batas atas dan bisa dipesan berapa saja.
  '''
}

Table suppliers {
  id integer [pk, increment]
  name varchar(150) [not null, note: 'VR-22']
  address text
  phone varchar(20) [note: 'Opsional, VR-23']
  email varchar(100) [note: 'Opsional, VR-24']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    name
  }
}

Table customers {
  id integer [pk, increment]
  name varchar(150) [not null, note: 'VR-22']
  address text
  phone varchar(20) [note: 'Opsional, VR-23']
  email varchar(100) [note: 'Opsional, VR-24']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    name
  }
}


// ============================================================
// TRANSAKSI
// ============================================================
// ============================================================
// PURCHASING
// ============================================================

Table purchase_orders {
  id integer [pk, increment]
  po_number varchar(20) [not null, unique, note: 'Otomatis, format PO-YYYYMM-0001']
  po_date date [not null, default: `current_date`]
  supplier_id integer [not null]
  status varchar(15) [not null, default: 'Draft', note: 'Draft | Approved | Dibatalkan']
  total_amount numeric(15,2) [not null, default: 0, note: 'SUM(qty x unit_price), dihitung server (BR-10)']
  created_by integer [not null]
  created_at timestamptz [not null, default: `now()`]
  approved_by integer [note: 'Diisi saat Draft -> Approved (UC-08)']
  approved_at timestamptz
  cancelled_by integer
  cancelled_at timestamptz
  cancel_reason text [note: 'Wajib saat dibatalkan (VR-13)']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    po_date
    status
    supplier_id
  }

  checks {
    `status IN ('Draft','Approved','Dibatalkan')` [name: 'chk_po_status']
    `total_amount >= 0` [name: 'chk_po_total']
    `status <> 'Approved' OR (approved_by IS NOT NULL AND approved_at IS NOT NULL)` [name: 'chk_po_approval']
    `status <> 'Dibatalkan' OR (cancelled_by IS NOT NULL AND cancelled_at IS NOT NULL AND cancel_reason IS NOT NULL)` [name: 'chk_po_cancel']
  }
}

Table purchase_order_items {
  id integer [pk, increment]
  purchase_order_id integer [not null]
  product_id integer [not null]
  quantity integer [not null, note: 'VR-08, bilangan bulat > 0']
  unit_price numeric(15,2) [not null, note: 'Harga saat transaksi (VR-09)']
  subtotal numeric(15,2) [not null, note: 'quantity x unit_price']

  indexes {
    (purchase_order_id, product_id) [unique, name: 'uq_po_items_po_product']
    product_id
  }

  checks {
    `quantity > 0` [name: 'chk_po_items_qty']
    `unit_price >= 0` [name: 'chk_po_items_price']
    `subtotal >= 0` [name: 'chk_po_items_subtotal']
  }
}

Table goods_receipts {
  id integer [pk, increment]
  gr_number varchar(20) [not null, unique, note: 'Otomatis, format GR-YYYYMM-0001']
  purchase_order_id integer [not null, note: 'Harus PO berstatus Approved (VR-10)']
  receipt_date date [not null, default: `current_date`]
  status varchar(15) [not null, default: 'Aktif', note: 'Aktif | Dibatalkan']
  created_by integer [not null]
  created_at timestamptz [not null, default: `now()`]
  cancelled_by integer
  cancelled_at timestamptz
  cancel_reason text
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    purchase_order_id
    receipt_date
    status
  }

  checks {
    `status IN ('Aktif','Dibatalkan')` [name: 'chk_gr_status']
    `status <> 'Dibatalkan' OR (cancelled_by IS NOT NULL AND cancelled_at IS NOT NULL AND cancel_reason IS NOT NULL)` [name: 'chk_gr_cancel']
  }

  Note: 'Satu PO dapat memiliki banyak GR (penerimaan bertahap).'
}

Table goods_receipt_items {
  id integer [pk, increment]
  goods_receipt_id integer [not null]
  purchase_order_item_id integer [not null, note: 'Produk diturunkan dari item PO, tidak disimpan ulang']
  quantity_received integer [not null, note: 'VR-11, hanya baris > 0 yang disimpan (VR-26)']

  indexes {
    (goods_receipt_id, purchase_order_item_id) [unique, name: 'uq_gr_items_gr_poitem']
    purchase_order_item_id
  }

  checks {
    `quantity_received > 0` [name: 'chk_gr_items_qty']
  }
}

// ============================================================
// SALES
// ============================================================

Table sales_orders {
  id integer [pk, increment]
  so_number varchar(20) [not null, unique, note: 'Otomatis, format SO-YYYYMM-0001']
  so_date date [not null, default: `current_date`]
  customer_id integer [not null]
  status varchar(15) [not null, default: 'Open', note: 'Open | Dibatalkan']
  total_amount numeric(15,2) [not null, default: 0, note: 'SUM(qty x unit_price), dihitung server (BR-10)']
  created_by integer [not null]
  created_at timestamptz [not null, default: `now()`]
  cancelled_by integer
  cancelled_at timestamptz
  cancel_reason text [note: 'Wajib saat dibatalkan (VR-13)']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    so_date
    status
    customer_id
  }

  checks {
    `status IN ('Open','Dibatalkan')` [name: 'chk_so_status']
    `total_amount >= 0` [name: 'chk_so_total']
    `status <> 'Dibatalkan' OR (cancelled_by IS NOT NULL AND cancelled_at IS NOT NULL AND cancel_reason IS NOT NULL)` [name: 'chk_so_cancel']
  }

  Note: 'SO tidak mereservasi stok. Status tetap Open selama pengiriman bertahap.'
}

Table sales_order_items {
  id integer [pk, increment]
  sales_order_id integer [not null]
  product_id integer [not null]
  quantity integer [not null, note: 'VR-08, bilangan bulat > 0']
  unit_price numeric(15,2) [not null, note: 'Harga saat transaksi (VR-09)']
  subtotal numeric(15,2) [not null, note: 'quantity x unit_price']

  indexes {
    (sales_order_id, product_id) [unique, name: 'uq_so_items_so_product']
    product_id
  }

  checks {
    `quantity > 0` [name: 'chk_so_items_qty']
    `unit_price >= 0` [name: 'chk_so_items_price']
    `subtotal >= 0` [name: 'chk_so_items_subtotal']
  }
}

Table deliveries {
  id integer [pk, increment]
  delivery_number varchar(20) [not null, unique, note: 'Otomatis, format DL-YYYYMM-0001']
  sales_order_id integer [not null, note: 'Harus SO berstatus Open (VR-29)']
  delivery_date date [not null, default: `current_date`]
  status varchar(15) [not null, default: 'Aktif', note: 'Aktif | Dibatalkan']
  created_by integer [not null]
  created_at timestamptz [not null, default: `now()`]
  cancelled_by integer
  cancelled_at timestamptz
  cancel_reason text
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    sales_order_id
    delivery_date
    status
  }

  checks {
    `status IN ('Aktif','Dibatalkan')` [name: 'chk_dl_status']
    `status <> 'Dibatalkan' OR (cancelled_by IS NOT NULL AND cancelled_at IS NOT NULL AND cancel_reason IS NOT NULL)` [name: 'chk_dl_cancel']
  }

  Note: 'Satu SO dapat memiliki banyak Delivery (pengiriman bertahap).'
}

Table delivery_items {
  id integer [pk, increment]
  delivery_id integer [not null]
  sales_order_item_id integer [not null, note: 'Produk diturunkan dari item SO, tidak disimpan ulang']
  quantity_delivered integer [not null, note: 'VR-30, hanya baris > 0 yang disimpan (VR-31)']

  indexes {
    (delivery_id, sales_order_item_id) [unique, name: 'uq_dl_items_dl_soitem']
    sales_order_item_id
  }

  checks {
    `quantity_delivered > 0` [name: 'chk_dl_items_qty']
  }
}

// ============================================================
// INVENTORY
// ============================================================

Table stock_balances {
  product_id integer [pk, note: 'Satu baris per produk, dibuat bersama produk dengan quantity 0']
  quantity integer [not null, default: 0, note: 'Saldo stok terkini']
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `quantity >= 0` [name: 'chk_stock_balances_qty_nonneg'] // BR-07, pengaman terakhir
  }

  Note: 'Hanya diubah oleh StockService bersama stock_movements dalam satu transaction. Dikunci dengan SELECT ... FOR UPDATE saat Delivery.'
}

Table stock_movements {
  id bigint [pk, increment]
  product_id integer [not null]
  movement_type varchar(15) [not null, note: 'masuk | keluar | penyesuaian']
  quantity_change integer [not null, note: 'Bertanda: + menambah stok, - mengurangi stok. SUM per produk = stock_balances.quantity (NFR-09)']
  movement_date timestamptz [not null, default: `now()`]
  reference_type varchar(30) [not null, note: 'GOODS_RECEIPT | GOODS_RECEIPT_CANCEL | DELIVERY | DELIVERY_CANCEL | ADJUSTMENT']
  reference_id integer [note: 'ID dokumen sumber (generik, tanpa FK agar jenis dokumen baru mudah ditambah, NFR-19)']
  reference_number varchar(20) [note: 'Salinan nomor dokumen untuk tampilan histori']
  notes varchar(255)
  created_by integer [not null, note: 'Pengguna pencatat']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (product_id, movement_date) [name: 'idx_stock_mov_product_date']
    (reference_type, reference_id) [name: 'idx_stock_mov_reference']
    movement_date
  }

  checks {
    `movement_type IN ('masuk','keluar','penyesuaian')` [name: 'chk_stock_mov_type']
    `quantity_change <> 0` [name: 'chk_stock_mov_nonzero']
    `movement_type <> 'masuk' OR quantity_change > 0` [name: 'chk_stock_mov_masuk']
    `movement_type <> 'keluar' OR quantity_change < 0` [name: 'chk_stock_mov_keluar']
  }

  Note: 'Append-only. Tidak ada UPDATE/DELETE. Pembatalan dokumen menambah movement pembalik (BR-06, BR-09).'
}

// ============================================================
// RELASI (semua ON DELETE RESTRICT, BR-09)
// ============================================================

// Master & autentikasi
Ref fk_users_role: users.role_id > roles.id [delete: restrict]
Ref fk_products_category: products.category_id > categories.id [delete: restrict]
Ref fk_products_unit: products.unit_id > units.id [delete: restrict]

// Purchasing
Ref fk_po_supplier: purchase_orders.supplier_id > suppliers.id [delete: restrict]
Ref fk_po_created_by: purchase_orders.created_by > users.id [delete: restrict]
Ref fk_po_approved_by: purchase_orders.approved_by > users.id [delete: restrict]
Ref fk_po_cancelled_by: purchase_orders.cancelled_by > users.id [delete: restrict]

Ref fk_po_items_po: purchase_order_items.purchase_order_id > purchase_orders.id [delete: restrict]
Ref fk_po_items_product: purchase_order_items.product_id > products.id [delete: restrict]

Ref fk_gr_po: goods_receipts.purchase_order_id > purchase_orders.id [delete: restrict]
Ref fk_gr_created_by: goods_receipts.created_by > users.id [delete: restrict]
Ref fk_gr_cancelled_by: goods_receipts.cancelled_by > users.id [delete: restrict]

Ref fk_gr_items_gr: goods_receipt_items.goods_receipt_id > goods_receipts.id [delete: restrict]
Ref fk_gr_items_po_item: goods_receipt_items.purchase_order_item_id > purchase_order_items.id [delete: restrict]

// Sales
Ref fk_so_customer: sales_orders.customer_id > customers.id [delete: restrict]
Ref fk_so_created_by: sales_orders.created_by > users.id [delete: restrict]
Ref fk_so_cancelled_by: sales_orders.cancelled_by > users.id [delete: restrict]

Ref fk_so_items_so: sales_order_items.sales_order_id > sales_orders.id [delete: restrict]
Ref fk_so_items_product: sales_order_items.product_id > products.id [delete: restrict]

Ref fk_dl_so: deliveries.sales_order_id > sales_orders.id [delete: restrict]
Ref fk_dl_created_by: deliveries.created_by > users.id [delete: restrict]
Ref fk_dl_cancelled_by: deliveries.cancelled_by > users.id [delete: restrict]

Ref fk_dl_items_dl: delivery_items.delivery_id > deliveries.id [delete: restrict]
Ref fk_dl_items_so_item: delivery_items.sales_order_item_id > sales_order_items.id [delete: restrict]

// Inventory
Ref fk_stock_balances_product: stock_balances.product_id - products.id [delete: restrict]
Ref fk_stock_mov_product: stock_movements.product_id > products.id [delete: restrict]
Ref fk_stock_mov_user: stock_movements.created_by > users.id [delete: restrict]

// ============================================================
// KELOMPOK TABEL (agar diagram rapi)
// ============================================================

TableGroup master_dan_autentikasi {
  roles
  users
  categories
  units
  products
  suppliers
  customers
}

TableGroup purchasing {
  purchase_orders
  purchase_order_items
  goods_receipts
  goods_receipt_items
}

TableGroup sales {
  sales_orders
  sales_order_items
  deliveries
  delivery_items
}

TableGroup inventory {
  stock_balances
  stock_movements
}

// ============================================================
// DATA AWAL (peran bersifat tetap)
// ============================================================

Records roles(id, code, name) {
  1, 'admin', 'Admin'
  2, 'purchasing', 'Staf Purchasing'
  3, 'gudang', 'Staf Gudang'
  4, 'sales', 'Staf Sales'
  5, 'manajer', 'Manajer'
}


Ref: "deliveries"."delivery_number" -? "deliveries"."id"