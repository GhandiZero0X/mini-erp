<mxfile host="app.diagrams.net"><diagram name="Activity 5.4.3" id="act3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="1654"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane_Pengguna" value="Pengguna Berwenang" style="swimlane;html=1;startSize=30;horizontal=1;fontStyle=1;fontSize=13;fillColor=none;strokeColor=#666666;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="280" height="1480" as="geometry"/></mxCell><mxCell id="lane_Sistem" value="Sistem" style="swimlane;html=1;startSize=30;horizontal=1;fontStyle=1;fontSize=13;fillColor=none;strokeColor=#666666;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="280" y="0" width="640" height="1480" as="geometry"/></mxCell><mxCell id="st" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="140" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="P1" value="Pilih menu laporan (Pembelian, Penjualan, Stok, atau Produk Terlaris)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="45" y="120" width="220" height="60" as="geometry"/></mxCell><mxCell id="P3" value="Ubah periode (dan kategori pada Laporan Stok), lalu tekan Tampilkan" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="45" y="350" width="220" height="60" as="geometry"/></mxCell><mxCell id="P2" value="Tinjau laporan (halaman bersifat read-only)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="45" y="1150" width="220" height="60" as="geometry"/></mxCell><mxCell id="D4" value="Lihat periode atau filter lain?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="1260" width="190" height="90" as="geometry"/></mxCell><mxCell id="F2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="140" y="1400" width="30" height="30" as="geometry"/></mxCell><mxCell id="V1" value="Periksa sesi login dan hak akses terhadap laporan yang dipilih" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="115" width="240" height="70" as="geometry"/></mxCell><mxCell id="D1" value="Punya akses?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="225" width="160" height="80" as="geometry"/></mxCell><mxCell id="E1" value="Belum login: alihkan ke /login. Tanpa hak akses: tolak (VR-17) dan alihkan ke /dashboard" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="640" y="225" width="240" height="80" as="geometry"/></mxCell><mxCell id="F1" value="Akses ditolak" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="745" y="340" width="30" height="30" as="geometry"/></mxCell><mxCell id="V2" value="Bersihkan filter: tanggal kosong diisi default bulan berjalan" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="345" width="240" height="70" as="geometry"/></mxCell><mxCell id="V3" value="Validasi format tanggal dan urutan periode (tanggal mulai tidak melebihi tanggal akhir)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="450" width="240" height="60" as="geometry"/></mxCell><mxCell id="D2" value="Periode valid?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="545" width="160" height="80" as="geometry"/></mxCell><mxCell id="E2" value="Tampilkan pesan error periode (VR-66 / VR-14), data tidak di-query" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="640" y="555" width="240" height="60" as="geometry"/></mxCell><mxCell id="S1" value="Ambil data (read-only) sesuai jenis laporan:&lt;br&gt;• Pembelian: daftar PO + total pembelian&lt;br&gt;• Penjualan: daftar SO + total penjualan&lt;br&gt;• Stok: stok awal, masuk, keluar, akhir dari stock_movements (filter kategori opsional)&lt;br&gt;• Produk Terlaris: 10 produk dengan kuantitas tertinggi" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="240" height="150" as="geometry"/></mxCell><mxCell id="D3" value="Ada data pada periode?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="330" y="875" width="180" height="90" as="geometry"/></mxCell><mxCell id="E3" value="Tampilkan empty state (mis. &quot;Tidak ada data pembelian pada periode ini.&quot;)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="640" y="890" width="240" height="60" as="geometry"/></mxCell><mxCell id="S2" value="Tampilkan tabel laporan beserta total/ringkasan; status ditampilkan sebagai badge" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="1010" width="240" height="80" as="geometry"/></mxCell><mxCell id="e1" value="" st